From 5be853c75e02f7485fbeb8c82273f08c1b417828 Mon Sep 17 00:00:00 2001
From: Itsnatch <kamaumark996@gmail.com>
Date: Sat, 18 Jul 2026 11:42:47 +0300
Subject: [PATCH] fix: separate account approval from KYC eligibility for money
 movement

Root cause (confirmed via live DB trace): sync_employee_from_onboarding()
and handle_employer_onboarding_approval() only fire their promotion
logic IF NEW.status = 'approved' -- there was no symmetric path to
demote employees.kyc_status / employers state when a later KYC document
rejection correctly recomputed employee_onboarding.status /
employer_onboarding.status back down. Once an account was approved,
employees.kyc_status and employers.status stayed at their promotion-time
values forever, so a post-approval document rejection never blocked
money movement -- exactly the scenario described: an admin approves an
account, a document (required or not) later gets rejected, and the
system still treated the account as fully KYC-approved.

Added two DB triggers (mirroring the existing
fn_sync_employer_risk_score_to_live pattern already used in this
codebase) that keep employees.kyc_status and a new employers.is_verified
flag continuously synced to the live onboarding rollup, in both
directions -- without touching employees.status / employers.status,
which remain the admin-controlled account-approval flags (dashboard
access). This is the intended 3-way split:
  - account approval (employees.status / employers.status) -> dashboard
    access only, admin discretion, independent of KYC state
  - KYC approval (employees.kyc_status / employers.is_verified) -> now
    continuously live-synced, gates money movement
  - review requests (risk_review_requests / bank_change_requests) --
    already a separate workflow, unaffected by this change

lib/services/payout-service.ts's checkEmployeeEligibility() already
checked employees.kyc_status as a separate condition from
employees.status -- it starts working correctly automatically once the
new trigger keeps kyc_status live-synced, no route code change needed
there. Added the equivalent employer-side check (is_verified) at both
the real disbursement chokepoint (payout-service.ts, which previously
didn't even select employer status/is_verified) and at advance-request
creation time (request-advance/route.ts).

Verified live end-to-end against the Notion Labs test employer: toggling
employer_onboarding.status to a non-approved value flipped
employers.is_verified to false while employers.status stayed 'approved'
untouched, then correctly re-synced back to true on re-approval.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .../request-advance/route.ts                  | 11 ++-
 lib/services/payout-service.ts                | 17 +++-
 ...8090000_sync_kyc_status_to_live_tables.sql | 90 +++++++++++++++++++
 3 files changed, 116 insertions(+), 2 deletions(-)
 create mode 100644 supabase/migrations/20260718090000_sync_kyc_status_to_live_tables.sql

diff --git a/app/api/employee-dashboard/request-advance/route.ts b/app/api/employee-dashboard/request-advance/route.ts
index d1175e1..ace13a7 100644
--- a/app/api/employee-dashboard/request-advance/route.ts
+++ b/app/api/employee-dashboard/request-advance/route.ts
@@ -253,7 +253,7 @@ export async function POST(req: NextRequest) {
     // organization_id is required for the advances.organization_id NOT NULL constraint.
     const { data: employerRecord, error: employerLookupError } = await adminSupabase
       .from('employers')
-      .select('id, organization_id, status, ewa_enabled, disbursements_frozen, is_defaulted, auto_approve')
+      .select('id, organization_id, status, is_verified, ewa_enabled, disbursements_frozen, is_defaulted, auto_approve')
       .eq('onboarding_id', employee.employer_id)
       .maybeSingle();
 
@@ -263,6 +263,15 @@ export async function POST(req: NextRequest) {
     if (employerRecord.status !== 'approved') {
       return errorResponse(403, 'Your employer account is not yet fully activated. Please contact support.');
     }
+    // status ('approved') is the admin-controlled account flag and can stay
+    // 'approved' indefinitely; is_verified is kept live-synced to the
+    // employer's actual KYC rollup (trg_sync_employer_kyc_to_live) and flips
+    // to false the moment a KYC document is rejected post-approval, even
+    // though the account itself remains active — that must independently
+    // block money movement here.
+    if (employerRecord.is_verified !== true) {
+      return errorResponse(403, 'Your employer’s KYC verification is not currently valid. Please contact support.');
+    }
     if (employerRecord.ewa_enabled === false) {
       return errorResponse(403, 'EWA is not currently enabled for your employer.');
     }
