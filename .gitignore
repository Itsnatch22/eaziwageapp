# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/



# production
/build
/rules

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# antigravitycli
.antigravitycli

#supabase — ad-hoc schema dump files stay ignored (they go stale and mislead,
# see commit 9a17b48); migrations/ is Supabase's own applied migration
# history and is tracked so the repo has a real record instead of none.
supabase/*
!supabase/migrations/
!supabase/migrations/**

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/tests/.auth/

# local-only project notes for Claude Code
CLAUDE.md
