import { NextResponse, type NextRequest } from 'next/server';
import { createServerClient } from '@supabase/ssr';
import { createClient } from '@supabase/supabase-js';

type UserRole = 'employer' | 'employee' | 'admin';

interface Profile {
  role_normalized: UserRole;
  role: UserRole;
  email_verified: boolean;
}

export async function proxy(request: NextRequest): Promise<NextResponse> {
  const { pathname } = request.nextUrl;

  const response = NextResponse.next({
    request: { headers: request.headers },
  });

  const supabase = createServerClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
    {
      cookies: {
        getAll: () => request.cookies.getAll(),
        setAll: (cookies) =>
          cookies.forEach(({ name, value, options }) =>
            response.cookies.set(name, value, options)
          ),
      },
    }
  );

  const {
    data: { user },
  } = await supabase.auth.getUser();

  const isAuthenticated = !!user;

  const PUBLIC_PATHS = new Set([
    '/',
    '/register',
    '/forgot-password',
    '/reset-password',
    '/verify-email',
    '/admin/admin-login',
    '/admin/admin-signup',
  ]);

  const isPublicPath = PUBLIC_PATHS.has(pathname);
  const isAdminRoute =
    pathname.startsWith('/admin') &&
    !pathname.startsWith('/admin/admin-login') &&
    !pathname.startsWith('/admin/admin-signup');

  const isEmployerDashboard = pathname.startsWith('/dashboards/employer-dashboard');
  const isEmployeeDashboard = pathname.startsWith('/dashboards/employee-dashboard');
  const isDashboardRoute = isEmployerDashboard || isEmployeeDashboard;

  if (!isAuthenticated) {
    if (isPublicPath) return response;

    if (isDashboardRoute || isAdminRoute) {
      const loginUrl = new URL('/', request.url);
      loginUrl.searchParams.set('next', pathname);
      return NextResponse.redirect(loginUrl);
    }

    return response;
  }

  // ─────────────────────────────────────────────
  // 2. FETCH AUTHORITY (Parallel)
  // ─────────────────────────────────────────────
  const supabaseAdmin = createClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.SUPABASE_SERVICE_ROLE_KEY!,
    { auth: { persistSession: false, autoRefreshToken: false } }
  );

  const [profileRes, adminRes] = await Promise.all([
    supabaseAdmin
      .from('profiles')
      .select('role_normalized, role, email_verified')
      .eq('id', user.id)
      .maybeSingle<Profile>(),

    supabaseAdmin
      .from('system_admins')
      .select('email, role_normalized, is_admin')
      .eq('email', user.email)
      .maybeSingle(),
  ]);

  const profile = profileRes.data;
  const adminProfile = adminRes.data;
  
  const isAdmin = !!adminProfile && (adminProfile.is_admin === true || adminProfile.role_normalized === 'admin');
  const role = isAdmin ? 'admin' : (profile?.role_normalized || profile?.role || (user.user_metadata?.role as UserRole) || null);
  const isEmailVerified = isAdmin ? true : (profile?.email_verified ?? false);

  if (!role) {
    if (isPublicPath) return response;
    
    //return NextResponse.redirect(new URL('/register', request.url));
  }

  //if (!isEmailVerified && !pathname.startsWith('/verify-email') && !isPublicPath) {
   // return NextResponse.redirect(new URL('/verify-email', request.url));
  //}

  // ─────────────────────────────────────────────
  // 5. ADMIN AREA
  // ─────────────────────────────────────────────
  if (isAdminRoute) {
    if (!isAdmin) {
      const dashboard =
        role === 'employer'
          ? '/dashboards/employer-dashboard'
          : '/dashboards/employee-dashboard';

      return NextResponse.redirect(new URL(dashboard, request.url));
    }

    return response;
  }

  // ─────────────────────────────────────────────
  // 6. LOGGED IN ON PUBLIC PAGE
  // ─────────────────────────────────────────────
  if (isPublicPath) {
    const dashboard = isAdmin
      ? '/admin'
      : role === 'employer'
      ? '/dashboards/employer-dashboard'
      : '/dashboards/employee-dashboard';

    // Prevent redirecting if we are already where we need to be
    if (pathname === dashboard) return response;
    
    return NextResponse.redirect(new URL(dashboard, request.url));
  }

  // ─────────────────────────────────────────────
  // 7. DASHBOARD GUARDS
  // ─────────────────────────────────────────────
  if (isDashboardRoute) {
    if (isEmployeeDashboard && role === 'employer') {
      return NextResponse.redirect(
        new URL('/dashboards/employer-dashboard', request.url)
      );
    }

    if (isEmployerDashboard && role === 'employee') {
      return NextResponse.redirect(
        new URL('/dashboards/employee-dashboard', request.url)
      );
    }

    // Admins can stay or go to /admin
    if (isAdmin && !pathname.startsWith('/admin')) {
       return NextResponse.redirect(new URL('/admin', request.url));
    }
  }

  return response;
}

export const config = {
  matcher: [
    '/((?!api|_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp|ico|css|js|woff|woff2|ttf|eot)$).*)',
  ],
};
